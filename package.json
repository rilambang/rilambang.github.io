{
  "name": "rilambang-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/build-blog.py && vite build",
    "preview": "vite preview",
    "check:prose": "sh scripts/prose-check.sh",
    "check:deploy": "npm run build || exit 1; test -z \"$(git status --porcelain -- docs public)\" || (echo 'docs/public differ from a fresh build -- commit the build output'; exit 1)"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
